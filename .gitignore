node_modules/
dist/
build/
out/
# Recursos de empacotamento do Electron. `build/` acima e generico e casaria
# com esta pasta, mas o icone e **fonte**, nao artefato: sem ele versionado,
# `pnpm --filter @sparta/desktop package:win` num clone limpo produziria o
# instalador com o icone padrao do Electron em vez do icone do Sparta.
!apps/desktop/build/
!apps/desktop/build/**
coverage/
.vite/
.turbo/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*
.env
.env.*
!.env.example
apps/api/prisma/generated/
*.sqlite
*.sqlite3
data/local/
tmp/
services/analyzer/.venv/
__pycache__/
.pytest_cache/
*.egg-info/
.mypy_cache/

# Links simbolicos para .ai (config compartilhada entre agentes de IA)
/.claude
/.codex
/.agents

# Candidato de release local (Etapa 28b). Nunca versionado.
dist-installer/

# Artefatos de release. O diretorio e gerado; so o manifesto, os SBOM e os
# checksums sao versionados — eles descrevem o candidato e cabem num diff. O
# instalador, a imagem exportada e qualquer intermediario ficam de fora.
#
# A escada de `dir/*` + `!dir/` e obrigatoria: o git nao desce em diretorio
# excluido, entao um `artifacts/` simples faria toda negacao abaixo dele ser
# ignorada em silencio — e o manifesto nunca seria versionado. Foi o que
# aconteceu na primeira versao desta regra.
artifacts/*
!artifacts/releases/
artifacts/releases/*
!artifacts/releases/*/
artifacts/releases/*/*
!artifacts/releases/*/sparta-release-manifest.json
!artifacts/releases/*/sbom-*.json
!artifacts/releases/*/checksums.txt
