generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String?       @unique
  passwordHash String?
  displayName  String?
  createdAt    DateTime      @default(now())
  accounts     RiotAccount[]
}

model RiotAccount {
  id                  String                            @id @default(uuid())
  userId              String?
  puuid               String                            @unique
  gameName            String
  tagLine             String
  platformRegion      String
  regionalRouting     String
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  user                User?                             @relation(fields: [userId], references: [id])
  profile             PlayerProfile?
  matches             MatchParticipant[]
  championPool        PlayerChampionPoolEntry[]
  draftSessions       DraftSession[]
  postgameComparisons DraftPostGameComparisonRevision[]

  @@index([puuid])
}

model PlayerProfile {
  id                 String                @id @default(uuid())
  riotAccountId      String                @unique
  preferredRoles     String[]
  strengthsJson      Json                  @default("[]")
  weaknessesJson     Json                  @default("[]")
  recentFormJson     Json                  @default("{}")
  matchAnalysisLimit Int                   @default(50)
  updatedAt          DateTime              @updatedAt
  riotAccount        RiotAccount           @relation(fields: [riotAccountId], references: [id])
  championStats      PlayerChampionStats[]
}

model Champion {
  id                                      Int                       @id
  key                                     String                    @unique
  name                                    String
  title                                   String?
  roles                                   String[]
  version                                 String?
  // `info.difficulty` oficial da Data Dragon (Etapa 13), separado de
  // ChampionTag.difficulty, que pertence ao perfil estratégico derivado.
  dataDragonDifficulty                    Int?
  difficultyNormalized                    Float?
  difficultyNormalizationAlgorithmVersion String?
  tags                                    ChampionTag?
  participants                            MatchParticipant[]
  playerStats                             PlayerChampionStats[]
  poolEntries                             PlayerChampionPoolEntry[]
}

model PlayerChampionPoolEntry {
  id            String      @id @default(uuid())
  riotAccountId String
  championId    Int
  role          String
  source        String
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  riotAccount   RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)
  champion      Champion    @relation(fields: [championId], references: [id])

  @@unique([riotAccountId, championId, role])
  @@index([riotAccountId, role, enabled])
  @@index([championId])
}

model ChampionTag {
  id                 String    @id @default(uuid())
  championId         Int       @unique
  damageProfile      String
  tags               String[]
  blindSafety        Float
  difficulty         Float
  engage             Float
  peel               Float
  frontline          Float
  pickoff            Float
  waveclear          Float
  scaling            Float
  earlyPressure      Float
  // Proveniencia (Etapa 8). Tudo nullable: linha gravada antes desta etapa
  // nao tem origem registrada, e ausencia significa "nao informada" - nunca
  // "derivado" nem "revisado".
  dataDragonVersion  String?
  locale             String?
  sourceResource     String?
  algorithmVersion   String?
  generatedAt        DateTime?
  reviewState        String?
  reviewedDimensions String[]
  champion           Champion  @relation(fields: [championId], references: [id])

  @@index([championId])
}

model Match {
  id                  String                            @id @default(uuid())
  matchId             String                            @unique
  /// Identificador numérico compartilhado com o gameflow do LCU.
  gameId              String?
  platform            String
  patch               String?
  gameVersion         String?
  queueId             Int?
  gameMode            String?
  gameType            String?
  durationSeconds     Int?
  startedAt           DateTime?
  rawJson             Json?
  participants        MatchParticipant[]
  timeline            MatchTimeline?
  postgameReports     PostgameReport[]
  linkedDraftSessions DraftSession[]                    @relation("DraftSessionLinkedMatch")
  draftComparisons    DraftPostGameComparisonRevision[]

  @@unique([platform, gameId])
  @@index([matchId])
}

model MatchParticipant {
  id                     String            @id @default(uuid())
  matchId                String
  riotAccountId          String?
  puuid                  String
  championId             Int
  role                   String?
  teamId                 Int?
  won                    Boolean
  kills                  Int
  deaths                 Int
  assists                Int
  csPerMinute            Float
  goldPerMinute          Float
  damagePerMinute        Float
  visionScorePerMinute   Float
  killParticipation      Float?
  objectiveParticipation Float?
  // Numerador e denominador da participacao em objetivos (20260726150000).
  // NULL = nao observado; a razao acima e NULL junto.
  objectiveTakedowns     Int?
  teamObjectiveKills     Int?
  match                  Match             @relation(fields: [matchId], references: [id])
  riotAccount            RiotAccount?      @relation(fields: [riotAccountId], references: [id])
  champion               Champion          @relation(fields: [championId], references: [id])
  observation            MatchObservation?

  @@unique([matchId, puuid])
  @@index([puuid])
  @@index([championId])
}

model MatchTimeline {
  id             String @id @default(uuid())
  matchId        String @unique
  deathsBefore10 Int    @default(0)
  deathsBefore15 Int    @default(0)
  csAt10         Float?
  csAt15         Float?
  goldDiffAt15   Float?
  eventsJson     Json   @default("[]")
  match          Match  @relation(fields: [matchId], references: [id])
}

model PlayerChampionStats {
  id                            String        @id @default(uuid())
  playerProfileId               String
  championId                    Int
  role                          String
  games                         Int
  wins                          Int
  kills                         Int
  deaths                        Int
  assists                       Int
  csPerMinute                   Float
  goldPerMinute                 Float
  damagePerMinute               Float
  visionScorePerMinute          Float
  // Nullable desde 20260726120000: ausencia de dado nao pode ser gravada
  // como 0. Os *Samples guardam quantas partidas do agregado tinham o dado
  // (NULL = cobertura desconhecida, linha anterior a migration).
  killParticipation             Float?
  objectiveParticipation        Float?
  killParticipationSamples      Int?
  objectiveParticipationSamples Int?
  recentMatchesJson             Json          @default("[]")
  updatedAt                     DateTime      @updatedAt
  playerProfile                 PlayerProfile @relation(fields: [playerProfileId], references: [id])
  champion                      Champion      @relation(fields: [championId], references: [id])

  @@unique([playerProfileId, championId, role])
  @@index([championId])
}

/// Sessao real de champion select. Substitui o modelo anterior (Etapa 16),
/// que era codigo morto: tinha um `draftStateJson` sem contrato e nenhum
/// campo de ciclo de vida, origem ou vinculo com partida.
model DraftSession {
  id                        String                            @id @default(uuid())
  /// Conta Riot dona da sessao. O acesso e sempre filtrado por ela.
  riotAccountId             String
  /// "LCU" ou "USER". Sessao manual nunca e apresentada como observada.
  source                    String
  /// ACTIVE | LOCKED_IN | IN_GAME | COMPLETED | ABANDONED
  status                    String
  role                      String
  /// "LCU" ou "USER" - como a posicao foi obtida.
  roleSource                String
  queueId                   Int?
  gameVersion               String?
  patch                     String?
  selectedChampionId        Int?
  /// Estado conhecido do draft (aliados, inimigos, bans, adversario direto,
  /// picks desconhecidos). Contrato estruturado - NAO e o payload bruto do LCU.
  knownDraftJson            Json
  startedAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  lockedInAt                DateTime?
  completedAt               DateTime?
  /// Chave tecnica da sessao do lado do cliente. Unica por conta: uma nova
  /// entrada no champion select gera outra chave e portanto outra sessao.
  externalSessionId         String?
  /// `gameId` numérico observado pelo endpoint somente-leitura do LCU.
  externalGameId            String?
  externalGameIdSource      String?
  externalGameIdObservedAt  DateTime?
  /// Estado auditável do reconciliador.
  matchLinkStatus           String                            @default("PENDING")
  matchLinkStrategy         String?
  matchLinkAlgorithmVersion String?
  matchLinkEvidenceJson     Json                              @default("[]")
  matchLinkCandidateCount   Int                               @default(0)
  matchLinkReason           String?
  matchLinkDecidedAt        DateTime?
  /// `Match.matchId` do Match-V5. Preenchido exclusivamente pelo reconciliador.
  linkedMatchId             String?
  /// Valor pré-Etapa 21 informado pelo cliente, preservado só para auditoria.
  legacyLinkedMatchId       String?
  riotAccount               RiotAccount                       @relation(fields: [riotAccountId], references: [id])
  linkedMatch               Match?                            @relation("DraftSessionLinkedMatch", fields: [linkedMatchId], references: [matchId], onDelete: SetNull)
  snapshots                 RecommendationSnapshot[]
  reviews                   DraftReview[]
  matchLinkRevisions        DraftMatchLinkRevision[]
  postgameComparisons       DraftPostGameComparisonRevision[]

  @@unique([riotAccountId, externalSessionId])
  @@unique([riotAccountId, linkedMatchId])
  @@index([riotAccountId, status])
  @@index([riotAccountId, matchLinkStatus])
  @@index([externalGameId])
  @@index([linkedMatchId])
}

/// Histórico imutável de cada decisão material do reconciliador.
model DraftMatchLinkRevision {
  id               String       @id @default(uuid())
  draftSessionId   String
  revision         Int
  status           String
  strategy         String?
  matchId          String?
  externalGameId   String?
  evidenceJson     Json         @default("[]")
  candidateCount   Int          @default(0)
  algorithmVersion String
  reason           String
  decidedAt        DateTime     @default(now())
  draftSession     DraftSession @relation(fields: [draftSessionId], references: [id], onDelete: Cascade)

  @@unique([draftSessionId, revision])
  @@index([draftSessionId, decidedAt])
  @@index([matchId])
}

/// Execucao imutavel do motor de recomendacao. Snapshot novo so nasce quando
/// o input canonico muda; o anterior nunca e reescrito.
model RecommendationSnapshot {
  id                    String                            @id @default(uuid())
  draftSessionId        String
  /// SHA-256 da serializacao canonica do input. Nao depende de ordem de
  /// array nem do instante da analise.
  inputHash             String
  /// Input canonico completo, pra o snapshot ser auditavel sozinho.
  canonicalInputJson    Json
  algorithmVersionsJson Json
  dataCoverage          Float
  createdAt             DateTime                          @default(now())
  /// Quando um snapshot posterior passou a valer. Nulo enquanto e o atual.
  supersededAt          DateTime?
  /// Configuracao efetiva usada nesta execucao (Etapa 27b). Tudo nullable:
  /// snapshot anterior a esta etapa nao tem o eco gravado, e isso nunca e
  /// preenchido retroativamente. "RELEASE" carrega releaseId; ausencia de
  /// release ativa grava "BUILT_IN_BASELINE" sem releaseId.
  configurationSource        String?
  configurationReleaseId     String?
  configurationVersion       String?
  configHash                 String?
  /// `EffectiveRecommendationConfiguration` completa - os parametros efetivos
  /// (pesos, metricas desligadas, regras pos-agregacao) sobrevivem mesmo se a
  /// release referenciada mudar de estado depois.
  effectiveConfigurationJson Json?
  draftSession          DraftSession                      @relation(fields: [draftSessionId], references: [id], onDelete: Cascade)
  recommendations       PersistedRecommendation[]
  replayBundle          ReplayInputBundleRecord?
  postgameComparisons   DraftPostGameComparisonRevision[]

  @@unique([draftSessionId, inputHash])
  @@index([draftSessionId, createdAt])
}

/// Um candidato dentro de um snapshot. Guarda o que sustentou a posicao dele,
/// nao so o score agregado.
model PersistedRecommendation {
  id            String                 @id @default(uuid())
  snapshotId    String
  championId    Int
  championName  String
  rank          Int
  /// PRIMARY | ALTERNATIVE
  recGroup      String
  totalScore    Float
  dataCoverage  Float
  poolSource    String
  personalGames Int
  category      String
  confidence    String?
  /// Metricas estruturadas, pesos efetivos, motivos, alertas, limitacoes,
  /// proveniencia e analise estrategica daquele instante.
  detailJson    Json
  snapshot      RecommendationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, championId])
  @@index([championId])
}

/// Revisao humana de um draft ja registrado (Etapa 24).
///
/// Vive numa tabela SEPARADA de proposito: nada aqui altera sessao, snapshot,
/// ranking, metrica ou relatorio pos-game. Uma correcao nao sobrescreve - cria
/// outra linha apontando pra anterior em "supersedesReviewId".
model DraftReview {
  id                  String   @id @default(uuid())
  riotAccountId       String
  draftSessionId      String
  /// Snapshot vigente no lock-in. Nulo quando a sessao nao tinha nenhum.
  snapshotId          String?
  /// Partida vinculada no momento da revelacao. Nulo enquanto cega ou sem vinculo.
  matchId             String?
  /// IN_PROGRESS | PRE_MATCH_REVIEWED | COMPLETED | NEEDS_INVESTIGATION
  status              String
  reviewVersion       String
  preMatchJson        Json?
  postMatchJson       Json?
  /// Instante da revelacao explicita. Nulo = revisao ainda cega.
  resultRevealedAt    DateTime?
  createdAt           DateTime @default(now())
  completedAt         DateTime?
  /// Revisao que esta corrige, quando e uma correcao.
  supersedesReviewId  String?
  correctionReason    String?
  /// Preenchido quando outra revisao passa a valer no lugar desta.
  supersededAt        DateTime?
  /// Tags desnormalizadas so pra consulta agregada; a fonte e o JSON.
  issueTags           String[]
  draftSession        DraftSession @relation(fields: [draftSessionId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, status])
  @@index([draftSessionId, createdAt])
}

model PostgameReport {
  id               String                            @id @default(uuid())
  matchId          String
  puuid            String
  draftSessionId   String?
  reportJson       Json
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  match            Match                             @relation(fields: [matchId], references: [id])
  draftComparisons DraftPostGameComparisonRevision[]

  @@unique([matchId, puuid])
  @@index([puuid])
}

/// Revisão imutável da comparação entre o contexto histórico do draft e a
/// partida vinculada. Uma mudança legítima de fonte ou de algoritmo cria
/// outra revisão; nunca sobrescreve o relatório anterior.
model DraftPostGameComparisonRevision {
  id                     String                  @id @default(uuid())
  draftSessionId         String
  matchId                String
  snapshotId             String?
  postgameReportId       String?
  riotAccountId          String
  revision               Int
  inputHash              String
  algorithmVersion       String
  sourceVersionsJson     Json
  snapshotSignalIdsJson  Json                    @default("[]")
  coverage               Float
  status                 String
  unavailableReasonsJson Json                    @default("[]")
  reportJson             Json
  generatedAt            DateTime                @default(now())
  draftSession           DraftSession            @relation(fields: [draftSessionId], references: [id], onDelete: Cascade)
  match                  Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  snapshot               RecommendationSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  postgameReport         PostgameReport?         @relation(fields: [postgameReportId], references: [id], onDelete: SetNull)
  riotAccount            RiotAccount             @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@unique([draftSessionId, revision])
  @@unique([draftSessionId, inputHash, algorithmVersion])
  @@index([matchId, riotAccountId, generatedAt])
  @@index([snapshotId])
  @@index([postgameReportId])
}

model ReplayImportJob {
  id           String   @id @default(uuid())
  fileName     String
  status       String
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ApiCacheEntry {
  key         String    @id
  valueJson   Json
  expiresAt   DateTime
  collectedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Identidade lógica de uma nota oficial: patch + locale + URL oficial.
/// O conteúdo mutável vive em revisões imutáveis.
model PatchRelease {
  id        String                 @id @default(uuid())
  patch     String
  locale    String
  sourceUrl String
  createdAt DateTime               @default(now())
  revisions PatchReleaseRevision[]
  attempts  PatchImportAttempt[]

  @@unique([patch, locale, sourceUrl])
  @@index([patch, locale])
}

/// Evidência oficial imutável de uma versão da página. Uma edição posterior
/// da Riot cria outra revisão; nunca atualiza changesJson ou sourceHash.
model PatchReleaseRevision {
  id             String       @id @default(uuid())
  patchReleaseId String
  revision       Int
  sourceHash     String
  title          String
  publishedAt    DateTime?
  collectedAt    DateTime
  parserVersion  String
  status         String
  changesJson    Json
  provenanceJson Json
  createdAt      DateTime     @default(now())
  patchRelease   PatchRelease @relation(fields: [patchReleaseId], references: [id], onDelete: Cascade)

  @@unique([patchReleaseId, revision])
  @@unique([patchReleaseId, sourceHash])
  @@index([sourceHash])
}

/// Resultado sanitizado de cada tentativa controlada. Falhas ficam separadas
/// das revisões válidas para nunca fabricar um release vazio.
model PatchImportAttempt {
  id             String        @id @default(uuid())
  patchReleaseId String?
  patch          String
  locale         String
  sourceUrl      String
  attemptedAt    DateTime      @default(now())
  status         String
  errorCode      String?
  cacheState     String?
  patchRelease   PatchRelease? @relation(fields: [patchReleaseId], references: [id], onDelete: SetNull)

  @@index([patch, locale, attemptedAt])
  @@index([patchReleaseId, attemptedAt])
}

model MatchObservation {
  id                            String                   @id @default(uuid())
  matchParticipantId            String                   @unique
  extractorVersion              String
  teamPosition                  String?
  individualPosition            String?
  positionAssignedByMatchmaking String?
  normalizedRole                String?
  normalizedRoleSource          String?
  assignedRole                  String?
  positionDiverged              Boolean
  positionStatus                String
  runesStatus                   String
  primaryStyleId                Int?
  secondaryStyleId              Int?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  matchParticipant              MatchParticipant         @relation(fields: [matchParticipantId], references: [id], onDelete: Cascade)
  itemSlots                     MatchItemSlot[]
  runeSelections                MatchRuneSelection[]
  runeFragments                 MatchRuneFragment[]
  summonerSpellSlots            MatchSummonerSpellSlot[]

  @@index([normalizedRole])
  @@index([extractorVersion])
}

model MatchItemSlot {
  id                 String           @id @default(uuid())
  matchObservationId String
  slot               Int
  state              String
  itemId             Int?
  itemName           String?
  asset              String?
  catalogVersion     String?
  catalogStatus      String
  matchObservation   MatchObservation @relation(fields: [matchObservationId], references: [id], onDelete: Cascade)

  @@unique([matchObservationId, slot])
  @@index([itemId])
}

model MatchRuneSelection {
  id                 String           @id @default(uuid())
  matchObservationId String
  tree               String
  slotOrder          Int
  perkId             Int
  perkName           String?
  isKeystone         Boolean
  catalogVersion     String?
  catalogStatus      String
  matchObservation   MatchObservation @relation(fields: [matchObservationId], references: [id], onDelete: Cascade)

  @@unique([matchObservationId, tree, slotOrder])
  @@index([perkId])
}

model MatchRuneFragment {
  id                 String           @id @default(uuid())
  matchObservationId String
  slot               String
  state              String
  fragmentId         Int?
  fragmentName       String?
  catalogVersion     String?
  catalogStatus      String
  matchObservation   MatchObservation @relation(fields: [matchObservationId], references: [id], onDelete: Cascade)

  @@unique([matchObservationId, slot])
  @@index([fragmentId])
}

model MatchSummonerSpellSlot {
  id                 String           @id @default(uuid())
  matchObservationId String
  slot               Int
  state              String
  spellId            Int?
  spellName          String?
  asset              String?
  catalogVersion     String?
  catalogStatus      String
  matchObservation   MatchObservation @relation(fields: [matchObservationId], references: [id], onDelete: Cascade)

  @@unique([matchObservationId, slot])
  @@index([spellId])
}

/// Configuracao candidata do laboratorio offline de calibracao (Etapa 25b).
///
/// NAO e configuracao do motor: nenhuma linha desta tabela e lida por
/// `recommendFromPersonalPool`. Aprovar aqui e ato documental, nao ativacao.
model CalibrationCandidateConfig {
  id                         String                  @id @default(uuid())
  /// Conta Riot dona da configuracao. Todo acesso e filtrado por ela.
  riotAccountId              String
  /// Identidade estavel entre revisoes da mesma configuracao.
  lineageId                  String
  revision                   Int
  name                       String
  description                String?
  baselineAggregationVersion String
  candidateVersion           String
  /// Contrato `CalibrationCandidate` ja validado pelo dominio da Etapa 25a.
  configJson                 Json
  /// SHA-256 da serializacao canonica. Define o que e alteracao funcional:
  /// renomear nao muda o hash e portanto nao cria revisao.
  configHash                 String
  /// DRAFT | READY | EVALUATED | REJECTED | APPROVED_FOR_FUTURE_RELEASE
  status                     String
  laboratoryVersion          String
  createdAt                  DateTime                @default(now())
  /// Quando uma revisao posterior passou a valer. Nulo enquanto e a atual.
  supersededAt               DateTime?
  /// Decisao humana. Apenas documental - nao ativa nada.
  decisionBy                 String?
  decisionAt                 DateTime?
  decisionNote               String?
  decisionExperimentId       String?
  experiments                CalibrationExperiment[]
  releases                   RecommendationEngineRelease[]

  @@unique([lineageId, revision])
  @@index([riotAccountId, lineageId])
  @@index([riotAccountId, createdAt])
}

/// Execucao offline de uma configuracao candidata sobre snapshots historicos.
///
/// Resultado concluido e imutavel: `COMPLETED` nunca e reescrito, e falha nao
/// deixa resultado parcial consultavel.
model CalibrationExperiment {
  id                   String                      @id @default(uuid())
  riotAccountId        String
  candidateId          String
  /// PENDING | RUNNING | COMPLETED | FAILED
  status               String                      @default("PENDING")
  filtersJson          Json
  /// SHA-256 do input canonico (configuracao + filtros + snapshots + versoes).
  inputHash            String
  laboratoryVersion    String
  /// Snapshots efetivamente incluidos, congelados no momento da criacao.
  snapshotIdsJson      Json
  totalCases           Int                         @default(0)
  exactReplayCases     Int                         @default(0)
  integrityFailedCases Int                         @default(0)
  unsupportedCases     Int                         @default(0)
  missingInputCases    Int                         @default(0)
  excludedCases        Int                         @default(0)
  /// Relatorio agregado. Nulo enquanto nao concluiu.
  reportJson           Json?
  /// Motivo sanitizado da falha. Nunca carrega credencial ou stack.
  failureReason        String?
  createdAt            DateTime                    @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  candidate            CalibrationCandidateConfig  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cases                CalibrationExperimentCase[]

  /// Mesmo input funcional nao gera um segundo experimento.
  @@unique([riotAccountId, inputHash])
  @@index([riotAccountId, createdAt])
  @@index([candidateId])
}

/// Resultado individual por snapshot. Imutavel depois de concluido.
model CalibrationExperimentCase {
  id             String                @id @default(uuid())
  experimentId   String
  draftSessionId String
  snapshotId     String
  /// EXACT_REPLAY | REPLAY_INTEGRITY_FAILED | REPLAY_UNSUPPORTED_VERSION |
  /// REPLAY_MISSING_HISTORICAL_INPUT
  replayStatus   String
  role           String
  patch          String?
  /// `CalibrationCaseComparison` completo produzido pelo dominio da 25a.
  comparisonJson Json
  experiment     CalibrationExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, snapshotId])
  @@index([experimentId, replayStatus])
}

/// Captura prospectiva dos inputs de derivacao (Etapa 26b).
///
/// Um bundle por snapshot, gravado na MESMA transacao. Nao existe bundle
/// isolado, e snapshot novo nao e persistido sem ele. Conteudo canonico
/// validado, nunca payload bruto da Riot ou do LCU.
model ReplayInputBundleRecord {
  id                String                 @id @default(uuid())
  snapshotId        String                 @unique
  schemaVersion     String
  /// SHA-256 recalculado no backend antes da escrita.
  contentHash       String
  /// Contrato `ReplayInputBundle` validado. Nao carrega puuid nem credencial.
  contentJson       Json
  /// Instante da avaliacao: participa do hash e da recencia do risco.
  evaluatedAt       DateTime
  /// Instante da captura: metadado, fora do hash.
  capturedAt        DateTime
  /// Tamanho do conteudo canonico, para observabilidade.
  contentBytes      Int
  algorithmVersions Json
  createdAt         DateTime               @default(now())
  /// Ultimo resultado da verificacao offline. Nao altera o bundle.
  lastVerification  Json?
  snapshot          RecommendationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([contentHash])
}

/// Release operacional (Etapa 27b). Congela o `RecommendationReleaseArtifact`
/// puro da Etapa 27a e acrescenta o que e exclusivamente operacional: ciclo
/// de vida, ativacao, rollback e autoria.
///
/// `status` segue exatamente os 7 estados de `ReleaseLifecycleStatus`
/// (`packages/core`). Uma vez `READY_FOR_ACTIVATION`, `artifactJson` nunca e
/// reescrito - candidata alterada depois disso gera uma release NOVA, nunca
/// modifica esta linha.
///
/// Uma release cuja `status` e "ACTIVE" pode nao ser mais a **atualmente**
/// apontada por `RecommendationEngineActivePointer` (uma release mais nova
/// pode ter assumido o ponteiro depois): o dominio da 27a so permite
/// `ACTIVE -> ROLLED_BACK` como transicao de saida, entao uma release
/// superada continua com `status = "ACTIVE"` ate ser explicitamente revertida
/// - "esta ativa" (ponteiro) e "foi ativada e nunca revertida" (status) sao
/// fatos distintos de proposito.
model RecommendationEngineRelease {
  id                    String    @id @default(uuid())
  riotAccountId         String
  /// Identidade estavel da candidata (`CalibrationCandidateConfig.lineageId`).
  /// Sem FK de proposito: a lineage sobrevive a revisoes, e nenhuma coluna
  /// unica isolada existe pra ela referenciar.
  candidateId           String
  /// Revisao EXATA da candidata (`CalibrationCandidateConfig.id`) referenciada
  /// pelo artefato - nunca "a candidata atual". E o alvo real do FK abaixo.
  candidateRevisionId   String
  experimentId          String
  releaseVersion        String
  baselineVersion       String
  candidateVersion      String
  artifactSchemaVersion String
  /// `RecommendationReleaseArtifact` completo (Etapa 27a).
  artifactJson          Json
  artifactHash          String
  configHash            String
  /// DRAFT | VALIDATING | VALIDATION_FAILED | READY_FOR_ACTIVATION | ACTIVE |
  /// ROLLED_BACK | REJECTED - mesmos 7 estados de `ReleaseLifecycleStatus`.
  status                String    @default("DRAFT")
  /// Ultimo `ReleaseValidationResult`. Uma nova tentativa sobrescreve; o
  /// historico de tentativas vive em `RecommendationEngineReleaseEvent`.
  validationJson        Json?
  /// `artifactHash` no momento em que `validationJson` foi calculado - usado
  /// pra detectar artefato alterado depois da validacao.
  validatedArtifactHash String?
  validatedAt           DateTime?
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  activatedBy           String?
  activatedAt           DateTime?
  /// Release que era a ativa no instante em que esta foi ativada - alvo exato
  /// do rollback. Nulo quando esta foi ativada a partir da baseline.
  previousReleaseId     String?
  rolledBackBy          String?
  rolledBackAt          DateTime?
  rolledBackReason      String?
  candidate             CalibrationCandidateConfig @relation(fields: [candidateRevisionId], references: [id])
  events                RecommendationEngineReleaseEvent[]

  @@unique([riotAccountId, artifactHash])
  @@index([riotAccountId, status])
  @@index([riotAccountId, candidateId])
}

/// Ponteiro unico por conta para a release ativa. Ausencia de linha significa
/// "nenhuma release ativa" - a baseline explicita da Etapa 27a resolve nesse
/// caso. Nunca reescreve historico por si so: toda troca tambem grava um
/// evento em `RecommendationEngineReleaseEvent`.
model RecommendationEngineActivePointer {
  riotAccountId String   @id
  releaseId     String
  updatedAt     DateTime @updatedAt
  updatedBy     String
}

/// Historico auditavel append-only de toda mudanca material de uma release.
/// Nunca e reescrito nem apagado.
model RecommendationEngineReleaseEvent {
  id            String   @id @default(uuid())
  riotAccountId String
  releaseId     String
  /// CREATED | VALIDATION_STARTED | VALIDATION_COMPLETED | VALIDATION_FAILED |
  /// ACTIVATED | ROLLED_BACK | REJECTED
  eventType     String
  fromStatus    String?
  toStatus      String?
  actor         String?
  /// Motivo sanitizado - nunca stack trace nem detalhe de banco.
  reason        String?
  metadataJson  Json     @default("{}")
  createdAt     DateTime @default(now())
  release       RecommendationEngineRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, createdAt])
  @@index([releaseId, createdAt])
}
