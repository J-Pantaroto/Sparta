{
  "name": "@sparta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "catalog:sync": "tsx src/modules/catalog/sync-catalog-cli.ts",
    "champion-tags:generate": "tsx src/modules/catalog/generate-champion-tags-cli.ts",
    "champion-tags:check": "tsx src/modules/catalog/generate-champion-tags-cli.ts --check",
    "champion-capabilities:generate": "tsx src/modules/catalog/generate-champion-capabilities-cli.ts",
    "champion-capabilities:check": "tsx src/modules/catalog/generate-champion-capabilities-cli.ts --check",
    "backfill:match-participants": "tsx src/modules/matches/backfill-participants-cli.ts",
    "backfill:objective-participation": "tsx src/modules/matches/backfill-objective-participation-cli.ts",
    "backfill:match-observations": "tsx src/modules/matches/backfill-match-observations-cli.ts",
    "patches:import": "tsx src/modules/patches/import-patches-cli.ts",
    "patches:check": "tsx src/modules/patches/check-patches-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.11.1",
    "@sparta/core": "workspace:*",
    "@sparta/riot": "workspace:*",
    "fastify": "^5.4.0",
    "prisma": "^6.11.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.0.10"
  }
}
