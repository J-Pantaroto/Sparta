{
  "name": "sparta",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Sparta desktop assistant for League of Legends profile, draft and post-game analysis.",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @sparta/api --filter @sparta/desktop dev",
    "dev:api": "pnpm --filter @sparta/api dev",
    "dev:desktop": "pnpm --filter @sparta/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run scripts && pnpm -r test",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:verify-package": "node scripts/verify-release-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "github:setup": "tsx scripts/read-git-remote.ts",
    "github:push": "bash scripts/push-to-github.sh",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:build": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "electron",
      "esbuild",
      "prisma"
    ],
    "//overrides": "Correções de segurança em transitivos (Etapa 28a). Só patch/minor: nenhum salto de major, e cada faixa é a mínima que sai da versão vulnerável. fast-uri/find-my-way/@fastify/static chegam pela API (produção); brace-expansion e postcss só por ferramenta de desenvolvimento (eslint, typescript-eslint, vitest) e estão aqui por higiene, não por alcance em produção.",
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "find-my-way@<=9.6.0": ">=9.7.0",
      "@fastify/static@<=10.1.1": ">=10.1.2",
      "brace-expansion": ">=5.0.9",
      "postcss@<=8.5.22": ">=8.5.23",
      "app-builder-lib>@noble/hashes": "^1.8.0"
    }
  }
}
