NODE_ENV=development
API_PORT=3333
API_HOST=0.0.0.0
DATABASE_URL=postgresql://sparta:sparta@postgres:5432/sparta
REDIS_URL=redis://redis:6379
RIOT_API_KEY=change_me
RIOT_PLATFORM_REGION=br1
RIOT_REGIONAL_ROUTING=americas
DATA_DRAGON_LOCALE=pt_BR
ANALYZER_URL=http://analyzer:8000
DESKTOP_API_URL=http://localhost:3333
# Precisa do prefixo VITE_ para o Vite expor a variavel no renderer do desktop.
VITE_API_URL=http://localhost:3333
# Segredo do token de sessao (auth). Troque em producao.
AUTH_TOKEN_SECRET=change_me
AUTH_TOKEN_TTL_SECONDS=2592000
PUBLIC_API_URL=http://localhost:3333
CORS_ALLOWED_ORIGINS=http://localhost:5173,null
TRUST_PROXY_HOPS=0
API_DOCS_ENABLED=true
LOG_LEVEL=info
GLOBAL_RATE_LIMIT_MAX=100
CREDENTIAL_RATE_LIMIT_MAX=5
REQUEST_TIMEOUT_MS=30000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_GRACE_PERIOD_MS=15000
