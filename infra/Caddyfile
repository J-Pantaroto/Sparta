# Reverse proxy / servidor do site institucional do Sparta GG.
#
# Preparado nesta etapa (31K), NÃO aplicado contra infraestrutura real — não
# existe VPS, domínio registrado nem certificado ainda. Ver
# docs/public-foundation-infrastructure.md para o checklist de aquisição e o
# procedimento de deploy quando os recursos existirem.
#
# Responsabilidades deste arquivo, nesta ordem: TLS automático (o Caddy
# provisiona/renova via Let's Encrypt sozinho, sem configuração extra),
# redirecionamento HTTP->HTTPS (automático pelo Caddy quando o bloco usa um
# domínio, não um `:porta`), domínio canônico (www -> apex), cabeçalhos de
# segurança, compressão, servir o site estático, e um lugar já reservado
# (comentado) para o proxy da futura API pública — que continua bloqueada
# pelos gates da Etapa 31D (BLOCKED_BY_EMAIL_PROVIDER_CONFIGURATION /
# BLOCKED_BY_RIOT_APPROVAL) e não deve ser habilitada por esta etapa.

spartagg.com.br {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP deliberadamente sem `unsafe-inline`/`unsafe-eval`: o site não
		# tem script inline nem embutido de terceiros. `connect-src` inclui o
		# host reservado da API pública (ver bloco comentado abaixo) porque
		# /confirmar-email e /redefinir-senha chamam a API diretamente do
		# navegador para consumir o token - as duas únicas páginas do site que
		# fazem fetch. Enquanto a API pública não existe, a chamada falha
		# honestamente (erro de rede), o que já é o comportamento esperado.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.spartagg.com.br; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Reservado para quando a API pública deixar de estar bloqueada — NÃO
	# habilitar nesta etapa. O nome do host (api.spartagg.com.br, ver DNS em
	# docs/public-foundation-infrastructure.md) já reflete a topologia final,
	# mesmo com o proxy desligado.
	#
	# handle /api/* {
	# 	uri strip_prefix /api
	# 	reverse_proxy api:3333
	# }

	# --- URLs públicas sem `.html` ---------------------------------------
	#
	# 1) A URL canônica de toda página é sem extensão. Pedido a
	#    `/pagina.html` responde 301 para `/pagina`, então a versão `.html`
	#    nunca serve conteúdo e não existe canônico duplicado.
	#
	#    O regex exige que o caractere após a primeira barra NÃO seja outra
	#    barra: sem isso, um pedido a `//exemplo.com/x.html` seria capturado
	#    como `/exemplo.com/x` e o redirect viraria `//exemplo.com/x`, que o
	#    navegador lê como URL protocol-relative — um open redirect. Com a
	#    guarda, esse caminho simplesmente não casa e cai no 404.
	#
	#    `/404.html` fica de fora de propósito: é a página de erro servida
	#    por `handle_errors`, não uma rota pública.
	redir /index.html / 301
	@legado {
		path_regexp legado ^/([^/].*)\.html$
		not path /404.html
	}
	redir @legado /{re.legado.1} 301

	root * /srv

	# 2) `/pagina` serve `/srv/pagina.html` por reescrita INTERNA (200, sem
	#    redirect). `try_files` roda depois de `redir` na ordem de diretivas
	#    do Caddy, então a reescrita não volta a passar pelo redirect — não
	#    há laço. Caminho inexistente segue para o `file_server` e vira 404.
	try_files {path} {path}.html

	file_server

	# Página 404 real (apps/site/404.html) em vez do texto genérico do Caddy —
	# preserva cabeçalho/rodapé do site e o `noindex` da página.
	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}
}

www.spartagg.com.br {
	redir https://spartagg.com.br{uri} permanent
}
http://127.0.0.1:8080 {
    bind 127.0.0.1
    respond /healthz 200
}