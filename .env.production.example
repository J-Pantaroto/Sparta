# Modelo somente documental. Substitua todos os marcadores no cofre de secrets;
# nunca copie este arquivo para `.env` nem versione valores reais.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3333
PUBLIC_API_URL=https://api.<DOMINIO_APROVADO>
CORS_ALLOWED_ORIGINS=null,https://<ORIGEM_WEB_APROVADA>
TRUST_PROXY_HOPS=1
API_DOCS_ENABLED=false
LOG_LEVEL=info

DATABASE_URL=postgresql://<USUARIO>:<SENHA>@<HOST>:5432/<BANCO>?sslmode=require&connection_limit=5&pool_timeout=10
REDIS_URL=rediss://:<SENHA>@<HOST>:6379

AUTH_TOKEN_SECRET=<SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES>
AUTH_TOKEN_TTL_SECONDS=86400
GLOBAL_RATE_LIMIT_MAX=100
CREDENTIAL_RATE_LIMIT_MAX=5
REQUEST_TIMEOUT_MS=30000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_GRACE_PERIOD_MS=15000

# O ambiente production não inicia sem uma chave; o valor deve vir do cofre.
RIOT_API_KEY=<SECRET_MANAGER_RIOT_PRODUCTION_KEY>
IDENTITY_MODE=RSO_REQUIRED
RSO_ENABLED=true
RSO_CLIENT_ID=<RIOT_RSO_CLIENT_ID_APROVADO>
RSO_REDIRECT_URI=https://api.<DOMINIO_APROVADO>/auth/riot/rso/callback
LOCAL_RIOT_LINK_ENABLED=false

# Provider transacional: adaptador real é Resend (api.resend.com). A chave
# nunca é versionada - só existe no cofre de secrets do ambiente real. O
# remetente é um endereço TRANSACIONAL do domínio, distinto de
# suporte@spartagg.com.br (esse continua sendo o canal humano). Depois de
# adicionar o domínio no painel da Resend, ele mesmo informa os registros DNS
# exatos (SPF/DKIM/Return-Path) a criar - não invente esses valores aqui.
EMAIL_PROVIDER_MODE=EXTERNAL
EMAIL_PROVIDER_API_KEY=<SECRET_MANAGER_RESEND_API_KEY>
EMAIL_PROVIDER_REPLY_TO=suporte@spartagg.com.br
EMAIL_VERIFICATION_FROM=contas@spartagg.com.br
EMAIL_VERIFICATION_URL_BASE=https://spartagg.com.br/confirmar-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_PER_HOUR=5
LOCAL_EMAIL_PREVIEW_ENABLED=false

# Redefinição de senha - mesmo provider, mesmo desenho de token, janela
# própria (mais curta: uma redefinição de senha é mais sensível que uma
# confirmação de email).
PASSWORD_RESET_URL_BASE=https://spartagg.com.br/redefinir-senha
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=5
RIOT_PLATFORM_REGION=br1
RIOT_REGIONAL_ROUTING=americas
DATA_DRAGON_LOCALE=pt_BR

# Serviço ainda não consumido pela API; manter ausente/desativado até decisão futura.
ANALYZER_URL=http://<ANALYZER_INTERNO>:8000
